# PostgreSQL / Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Single-owner access
APP_PASSWORD="replace-with-a-strong-password"
AUTH_SECRET="replace-with-a-long-random-value"

# Optional: lê views, curtidas e comentários dos vídeos publicados.
# Chave da YouTube Data API v3 (só dados públicos, sem OAuth).
# Sem ela, o painel de desempenho explica que ainda não foi configurado.
YOUTUBE_API_KEY=""

# Optional OpenAI-compatible editorial provider
LLM_BASE_URL="https://api.example.com/v1"
LLM_MODEL="provider-model-id"
LLM_API_KEY=""
